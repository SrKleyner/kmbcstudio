---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photo, ogImage } from '../lib/photos';
import { WHATSAPP_NUMBER } from '../config';
import { formatPrice } from '../lib/cart';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const BRAND = 'Masa Madre Pastelería';
const categories = [
  { id: 'panaderia', label: 'Panadería' },
  { id: 'tortas', label: 'Tortas y tartas' },
  { id: 'dulces', label: 'Dulces' },
];

const products = [
  { id: 'pan-masa-madre', category: 'panaderia', name: 'Pan de masa madre', desc: 'Fermentación de 24 horas, corteza crujiente y miga alveolada.', price: 4500, photo: '1509440159596-0249088772ff', alt: 'Pan de masa madre con semillas' },
  { id: 'croissant', category: 'panaderia', name: 'Croissant de mantequilla', desc: 'Laminado a mano con mantequilla pura, dorado y aireado.', price: 2200, photo: '1555507036-ab1f4038808a', alt: 'Croissants recién horneados' },
  { id: 'rol-canela', category: 'panaderia', name: 'Rol de canela', desc: 'Suave, especiado y con glaseado de vainilla.', price: 2800, photo: '1509365465985-25d11c17e812', alt: 'Roles de canela con azúcar' },
  { id: 'tarta-limon', category: 'tortas', name: 'Tarta de limón y merengue', desc: 'Base crocante, crema cítrica y merengue flameado. 8 porciones.', price: 12990, photo: '1519915028121-7d3463d20b13', alt: 'Tarta de limón con merengue' },
  { id: 'torta-frutilla', category: 'tortas', name: 'Porción torta de frutilla', desc: 'Bizcocho esponjoso, crema chantilly y frutillas frescas.', price: 3800, photo: '1565958011703-44f9829ba187', alt: 'Porción de torta con frutillas' },
  { id: 'torta-chocolate', category: 'tortas', name: 'Torta de chocolate intenso', desc: 'Tres capas de cacao con ganache. 12 porciones.', price: 24990, photo: '1578985545062-69928b1d9587', alt: 'Torta de chocolate con ganache' },
  { id: 'cupcake', category: 'dulces', name: 'Cupcake de chocolate', desc: 'Bizcocho húmedo con crema de cacao batida.', price: 2500, photo: '1550617931-e17a7b70dce2', alt: 'Cupcake de chocolate con crema' },
  { id: 'tartaletas', category: 'dulces', name: 'Caja de tartaletas (6 un.)', desc: 'Crema pastelera y fruta de estación sobre masa sablée.', price: 9800, photo: '1495147466023-ac5c588e2e94', alt: 'Tartaletas decoradas con fruta' },
  { id: 'panna-cotta', category: 'dulces', name: 'Panna cotta de frutilla', desc: 'Cremosa, ligera y servida en vasito individual.', price: 3500, photo: '1488477181946-6428a0291777', alt: 'Vasitos de panna cotta con frutillas' },
];

const gallery = [
  ['1486427944299-d1955d23e34d', 'Cupcakes de menta sobre fondo rosado'],
  ['1558961363-fa8fdf82db35', 'Galletas con chips de chocolate en canasto'],
  ['1464349095431-e9a21285b5f3', 'Torta de colores sobre pedestal'],
  ['1517433670267-08bbd4be890f', 'Mostrador de panadería con panes variados'],
  ['1563729784474-d77dbb933a9e', 'Cupcakes rosados con crema'],
  ['1535141192574-5d4897c12636', 'Torta de bodas con frutos rojos'],
];

const customUrl = buildWhatsAppUrl(
  WHATSAPP_NUMBER,
  `Hola ${BRAND}, quiero cotizar una torta personalizada.\nOcasión:\nNúmero de porciones:\nFecha de entrega:\nSabor / diseño:`,
);
const instagramUrl = 'https://instagram.com/';
---

<Base
  title={`${BRAND} | Pan y repostería artesanal`}
  description="Pan de masa madre, tortas y dulces hechos a mano. Arma tu pedido y envíalo por WhatsApp en segundos."
  fontsHref="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
  bodyClass="bg-cream text-cocoa font-[DM_Sans,sans-serif] antialiased selection:bg-crust selection:text-white"
  themeColor="#faf4e8"
  image={ogImage('1509440159596-0249088772ff', Astro.site)}
>
  <header class="absolute inset-x-0 top-0 z-20">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-6 text-white" aria-label="Principal">
      <a href="/pasteleria" class="font-[Playfair_Display,serif] text-2xl font-semibold">Masa Madre</a>
      <div class="flex items-center gap-6 text-sm font-medium">
        <a href="#menu" class="hidden hover:underline sm:inline">Menú</a>
        <a href="#personalizadas" class="hidden hover:underline sm:inline">Tortas a medida</a>
        <button type="button" data-open-cart class="rounded-full border border-white/60 px-4 py-2 transition hover:bg-white hover:text-cocoa">Mi pedido</button>
      </div>
    </nav>
  </header>

  <main>
    <section class="relative flex min-h-[92svh] items-end overflow-hidden px-5 pb-20 pt-40 text-white">
      <Image loading="eager" fetchpriority="high" data-parallax="40" src={photo('1578985545062-69928b1d9587')} alt="Torta de chocolate decorada sobre un pedestal" width="1600" height="1100" class="absolute inset-0 -z-20 h-[120%] w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-cocoa via-cocoa/55 to-cocoa/20" aria-hidden="true"></div>
      <div class="mx-auto w-full max-w-6xl" data-hero>
        <p class="text-sm font-medium uppercase tracking-[0.25em] text-cream/80">Horneado cada mañana</p>
        <h1 class="mt-5 max-w-3xl font-[Playfair_Display,serif] text-5xl font-medium leading-[1.05] sm:text-7xl lg:text-8xl">
          Hecho a mano, <em class="text-[#f0b98f]">con tiempo</em> y con cariño
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream/90">Pan de masa madre, tortas y dulces artesanales. Elige lo que te gusta y envía tu pedido directo por WhatsApp.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="#menu" class="inline-flex items-center justify-center rounded-full bg-crust px-8 py-4 font-semibold text-white transition hover:bg-crust-dark">Hacer mi pedido</a>
          <a href="#personalizadas" class="inline-flex items-center justify-center rounded-full border border-white/60 px-8 py-4 font-semibold transition hover:bg-white hover:text-cocoa">Torta personalizada</a>
        </div>
      </div>
    </section>

    <section class="border-b border-cocoa/10 px-5 py-8">
      <ul class="mx-auto grid max-w-6xl gap-4 text-center text-sm font-medium sm:grid-cols-3" data-reveal-group>
        <li>Ingredientes naturales, sin conservantes</li>
        <li>Pedidos con 24 horas de anticipación</li>
        <li>Retiro en tienda o despacho a domicilio</li>
      </ul>
    </section>

    <section id="menu" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-crust">Nuestro menú</p>
          <h2 class="mt-3 font-[Playfair_Display,serif] text-4xl font-medium sm:text-6xl">Elige tus favoritos</h2>
          <p class="mt-4 text-lg opacity-75">Agrega productos a tu pedido y envíalo por WhatsApp. Te confirmamos disponibilidad y horario.</p>
        </div>

        <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría" data-reveal>
          <button type="button" data-tab="all" aria-pressed="true" class="rounded-full border border-cocoa/20 px-5 py-2 text-sm font-semibold transition aria-pressed:border-cocoa aria-pressed:bg-cocoa aria-pressed:text-cream">Todo</button>
          {categories.map((c) => (
            <button type="button" data-tab={c.id} aria-pressed="false" class="rounded-full border border-cocoa/20 px-5 py-2 text-sm font-semibold transition aria-pressed:border-cocoa aria-pressed:bg-cocoa aria-pressed:text-cream">{c.label}</button>
          ))}
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p) => (
            <article data-category={p.category} class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm shadow-cocoa/5">
              <div class="aspect-[4/3] overflow-hidden">
                <Image src={photo(p.photo)} alt={p.alt} width="700" height="525" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-[Playfair_Display,serif] text-2xl font-medium">{p.name}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed opacity-75">{p.desc}</p>
                <div class="mt-5 flex items-center justify-between">
                  <p class="text-xl font-bold text-crust">{formatPrice(p.price)}</p>
                  <button type="button" data-add data-id={p.id} data-name={p.name} data-price={p.price} class="rounded-full bg-cocoa px-5 py-2.5 text-sm font-semibold text-cream transition hover:bg-crust" aria-label={`Agregar ${p.name} al pedido`}>Agregar</button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="personalizadas" class="bg-cocoa px-5 py-24 text-cream">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
        <div data-reveal class="grid grid-cols-2 gap-4">
          <Image src={photo('1535141192574-5d4897c12636')} alt="Torta de dos pisos con frutos rojos" width="600" height="800" loading="lazy" class="aspect-[3/4] w-full rounded-3xl object-cover" />
          <Image src={photo('1621303837174-89787a7d4729')} alt="Torta rosada con goteo y cono de helado" width="600" height="800" loading="lazy" class="mt-10 aspect-[3/4] w-full rounded-3xl object-cover" />
        </div>
        <div data-reveal>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#f0b98f]">Tortas personalizadas</p>
          <h2 class="mt-3 font-[Playfair_Display,serif] text-4xl font-medium sm:text-6xl">Tu celebración, a tu medida</h2>
          <p class="mt-5 text-lg text-cream/80">Cumpleaños, matrimonios, bautizos y eventos corporativos. Diseñamos la torta contigo: sabores, tamaño y decoración.</p>
          <ol class="mt-8 space-y-4">
            <li class="flex gap-4"><span class="font-[Playfair_Display,serif] text-3xl text-[#f0b98f]">1</span><span>Cuéntanos la ocasión, número de porciones y fecha.</span></li>
            <li class="flex gap-4"><span class="font-[Playfair_Display,serif] text-3xl text-[#f0b98f]">2</span><span>Recibe una propuesta de diseño y cotización por WhatsApp.</span></li>
            <li class="flex gap-4"><span class="font-[Playfair_Display,serif] text-3xl text-[#f0b98f]">3</span><span>Reserva con un abono y retira o recibe tu torta fresca.</span></li>
          </ol>
          <a href={customUrl} class="mt-10 inline-flex items-center justify-center rounded-full bg-crust px-8 py-4 font-semibold text-white transition hover:bg-crust-dark">Cotizar mi torta</a>
        </div>
      </div>
    </section>

    <section class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-crust">@masamadre.pasteleria</p>
            <h2 class="mt-3 font-[Playfair_Display,serif] text-4xl font-medium sm:text-5xl">Un vistazo a nuestro horno</h2>
          </div>
          <a href={instagramUrl} target="_blank" rel="noopener" class="text-sm font-semibold underline underline-offset-4 hover:text-crust">Síguenos en Instagram →</a>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-2 sm:gap-4 md:grid-cols-3" data-reveal-group>
          {gallery.map(([id, alt]) => (
            <li class="group relative aspect-square overflow-hidden rounded-2xl">
              <Image src={photo(id)} alt={alt} width="600" height="600" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-110" />
              <span class="absolute inset-0 flex items-center justify-center bg-cocoa/50 text-3xl text-white opacity-0 transition group-hover:opacity-100" aria-hidden="true">♥</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="border-t border-cocoa/10 px-5 pb-32 pt-8 text-center text-sm opacity-70">
    © {new Date().getFullYear()} {BRAND}. Demo ficticia · <a href="/" class="underline">Ver portafolio</a>
  </footer>

  <!-- Floating cart summary -->
  <div data-cart-bar hidden class="fixed inset-x-4 bottom-4 z-40 mx-auto max-w-xl">
    <button type="button" data-open-cart class="flex w-full items-center justify-between gap-4 rounded-full bg-cocoa px-6 py-4 text-cream shadow-2xl shadow-cocoa/40 transition hover:bg-crust">
      <span class="flex items-center gap-3 font-semibold">
        <span data-cart-count class="flex h-8 w-8 items-center justify-center rounded-full bg-crust text-sm">0</span>
        Ver mi pedido
      </span>
      <span data-cart-total class="text-lg font-bold">$0</span>
    </button>
  </div>

  <dialog data-cart-dialog class="m-auto max-h-[92svh] w-[calc(100%-1.5rem)] max-w-lg rounded-3xl bg-cream p-0 text-cocoa shadow-2xl backdrop:bg-cocoa/60 backdrop:backdrop-blur-sm" aria-labelledby="cart-title">
    <div class="p-6 sm:p-8">
      <div class="flex items-center justify-between">
        <h2 id="cart-title" class="font-[Playfair_Display,serif] text-3xl font-medium">Tu pedido</h2>
        <button type="button" data-close-cart class="flex h-10 w-10 items-center justify-center rounded-full border border-cocoa/20 text-xl" aria-label="Cerrar">×</button>
      </div>
      <p data-cart-empty class="mt-8 text-center opacity-70">Aún no has agregado productos.</p>
      <ul data-cart-list class="mt-4 divide-y divide-cocoa/10"></ul>
      <p class="sr-only" role="status" aria-live="polite" data-cart-live></p>

      <form data-cart-form hidden class="mt-4 space-y-4 border-t border-cocoa/10 pt-5">
        <p class="flex items-center justify-between text-lg font-bold"><span>Total</span><span data-dialog-total>$0</span></p>
        <label class="block text-sm font-semibold">Tu nombre
          <input name="name" required autocomplete="name" class="mt-1 w-full rounded-xl border border-cocoa/20 bg-white px-4 py-3 text-base font-normal" />
        </label>
        <fieldset>
          <legend class="text-sm font-semibold">Entrega</legend>
          <div class="mt-2 grid grid-cols-2 gap-3 text-sm">
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-cocoa/20 bg-white px-4 py-3 has-[:checked]:border-crust has-[:checked]:bg-crust/10"><input type="radio" name="mode" value="pickup" checked class="accent-[#b4532a]" /> Retiro en tienda</label>
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-cocoa/20 bg-white px-4 py-3 has-[:checked]:border-crust has-[:checked]:bg-crust/10"><input type="radio" name="mode" value="delivery" class="accent-[#b4532a]" /> Despacho</label>
          </div>
        </fieldset>
        <label data-address-field hidden class="block text-sm font-semibold">Dirección de entrega
          <input data-address-input name="address" autocomplete="street-address" class="mt-1 w-full rounded-xl border border-cocoa/20 bg-white px-4 py-3 text-base font-normal" />
        </label>
        <label class="block text-sm font-semibold">Notas (opcional)
          <textarea name="notes" rows="2" class="mt-1 w-full rounded-xl border border-cocoa/20 bg-white px-4 py-3 text-base font-normal" placeholder="Fecha, hora, alergias..."></textarea>
        </label>
        <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-4 font-semibold text-white transition hover:brightness-95">Enviar pedido por WhatsApp</button>
        <p class="text-center text-xs opacity-60">Se abrirá WhatsApp con tu pedido listo para enviar.</p>
      </form>
    </div>
  </dialog>

  <script>
    import { WHATSAPP_NUMBER } from '../config';
    import { initPasteleriaCart } from '../scripts/pasteleria-cart';
    initPasteleriaCart(WHATSAPP_NUMBER);
  </script>
</Base>
