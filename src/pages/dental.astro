---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photo, ogImage } from '../lib/photos';
import { WHATSAPP_NUMBER } from '../config';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const BRAND = 'Sonríe Clínica Dental';
const bookingUrl = buildWhatsAppUrl(
  WHATSAPP_NUMBER,
  `Hola ${BRAND}, quisiera agendar una evaluación. ¿Qué horarios tienen disponibles?`,
);

const treatments = [
  { name: 'Evaluación y limpieza', text: 'Diagnóstico completo, limpieza profunda y plan personalizado.', from: 35 },
  { name: 'Blanqueamiento dental', text: 'Hasta 8 tonos más claros en una sola sesión, sin sensibilidad.', from: 140 },
  { name: 'Ortodoncia invisible', text: 'Alineadores transparentes y cómodos con seguimiento mensual.', from: 890 },
  { name: 'Implantes dentales', text: 'Recupera tu sonrisa con piezas naturales y duraderas.', from: 650 },
  { name: 'Carillas de porcelana', text: 'Diseño de sonrisa digital con resultados naturales.', from: 220 },
  { name: 'Odontopediatría', text: 'Atención amable para que los más pequeños pierdan el miedo.', from: 30 },
];

const team = [
  { name: 'Dra. Valentina Rojas', role: 'Directora · Estética dental', img: '1594824476967-48c8b964273f', alt: 'Dra. Valentina Rojas con uniforme turquesa' },
  { name: 'Dr. Martín Salas', role: 'Implantología y cirugía', img: '1612349317150-e413f6a5b16d', alt: 'Dr. Martín Salas con bata blanca' },
  { name: 'Dra. Camila Ferrer', role: 'Ortodoncia', img: '1559839734-2b71ea197ec2', alt: 'Dra. Camila Ferrer sonriendo en un parque' },
];

const testimonials = [
  { name: 'Andrea M.', text: 'Me daba pánico ir al dentista y aquí me sentí tranquila desde el primer minuto. Mi sonrisa cambió por completo.', treatment: 'Blanqueamiento' },
  { name: 'Carlos P.', text: 'Agendé por WhatsApp en dos minutos y me atendieron puntual. Explican cada paso y los precios son claros.', treatment: 'Implante dental' },
  { name: 'Lucía R.', text: 'Llevé a mis dos hijos y salieron felices. Se nota el cariño y la tecnología de la clínica.', treatment: 'Odontopediatría' },
];

const faqs = [
  { q: '¿Cuánto dura la primera evaluación?', a: 'Entre 30 y 40 minutos. Incluye revisión, fotografías y un plan de tratamiento con presupuesto sin compromiso.' },
  { q: '¿Aceptan pagos en cuotas?', a: 'Sí. Ofrecemos planes de pago flexibles para tratamientos de ortodoncia, implantes y carillas.' },
  { q: '¿El blanqueamiento daña el esmalte?', a: 'No. Usamos geles profesionales supervisados por el odontólogo que respetan el esmalte y minimizan la sensibilidad.' },
  { q: '¿Atienden urgencias?', a: 'Sí. Escríbenos por WhatsApp y te damos el primer espacio disponible el mismo día.' },
  { q: '¿Cómo reservo mi cita?', a: 'Toca el botón de WhatsApp: el mensaje ya viene listo, solo envíalo y te confirmamos horario.' },
];

const nav = [['Tratamientos', '#tratamientos'], ['Resultados', '#resultados'], ['Equipo', '#equipo'], ['Preguntas', '#faq'], ['Ubicación', '#ubicacion']];
---

<Base
  title={`${BRAND} | Tu sonrisa en las mejores manos`}
  description="Clínica dental moderna: blanqueamiento, ortodoncia invisible, implantes y más. Agenda tu evaluación por WhatsApp."
  fontsHref="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap"
  bodyClass="bg-white text-slate-800 font-[Manrope,sans-serif] antialiased selection:bg-teal-200"
  themeColor="#f0fdfa"
  image={ogImage('1606811841689-23dfddce3e95', Astro.site)}
>
  <header class="sticky top-0 z-30 border-b border-teal-900/5 bg-white/80 backdrop-blur-lg">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4" aria-label="Principal">
      <a href="/dental" class="font-[Fraunces,serif] text-xl font-semibold text-teal-900">Sonríe<span class="text-teal-500">.</span></a>
      <ul class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
        {nav.map(([label, href]) => <li><a href={href} class="transition hover:text-teal-600">{label}</a></li>)}
      </ul>
      <a href={bookingUrl} class="rounded-full bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700">Agendar cita</a>
    </nav>
  </header>

  <main>
    <section class="relative overflow-hidden bg-gradient-to-b from-teal-50 via-white to-white px-5 pb-20 pt-14 sm:pt-20">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
        <div data-hero>
          <p class="inline-flex items-center gap-2 rounded-full bg-teal-100/70 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-teal-800">Clínica dental · Atención personalizada</p>
          <h1 class="mt-6 font-[Fraunces,serif] text-5xl font-medium leading-[1.05] tracking-tight text-teal-950 sm:text-6xl lg:text-7xl">
            Una sonrisa <em class="text-teal-600">que te represente</em>
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-600">Odontología moderna, sin dolor y con precios claros. Agenda en segundos por WhatsApp y recibe tu plan de tratamiento personalizado.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={bookingUrl} class="inline-flex items-center justify-center rounded-full bg-teal-600 px-8 py-4 font-semibold text-white shadow-lg shadow-teal-600/25 transition hover:-translate-y-0.5 hover:bg-teal-700">Reservar mi evaluación</a>
            <a href="#tratamientos" class="inline-flex items-center justify-center rounded-full border border-teal-900/15 px-8 py-4 font-semibold text-teal-900 transition hover:bg-teal-50">Ver tratamientos</a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium text-slate-600">
            <li class="flex items-center gap-2"><span class="text-teal-500" aria-hidden="true">✓</span> Primera evaluación desde US$ 35</li>
            <li class="flex items-center gap-2"><span class="text-teal-500" aria-hidden="true">✓</span> Pago en cuotas</li>
            <li class="flex items-center gap-2"><span class="text-teal-500" aria-hidden="true">✓</span> Urgencias el mismo día</li>
          </ul>
        </div>
        <div class="relative">
          <div class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-teal-200/40 blur-2xl" aria-hidden="true"></div>
          <div class="aspect-[4/5] overflow-hidden rounded-[2rem] shadow-2xl shadow-teal-900/15 sm:aspect-[5/5]">
            <Image loading="eager" fetchpriority="high" data-parallax="24" src={photo('1606811841689-23dfddce3e95')} alt="Odontólogo atendiendo a una paciente en un consultorio luminoso" width="1000" height="1000" class="h-[115%] w-full object-cover" />
          </div>
          <div class="absolute -bottom-5 left-4 rounded-2xl bg-white p-4 shadow-xl sm:-left-6">
            <p class="font-[Fraunces,serif] text-3xl font-semibold text-teal-700">+4.800</p>
            <p class="text-sm text-slate-500">sonrisas transformadas</p>
          </div>
        </div>
      </div>
    </section>

    <section id="tratamientos" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-600">Tratamientos</p>
          <h2 class="mt-3 font-[Fraunces,serif] text-4xl font-medium text-teal-950 sm:text-5xl">Todo para cuidar tu sonrisa</h2>
          <p class="mt-4 text-lg text-slate-600">Precios transparentes desde el primer día. Sin sorpresas.</p>
        </div>
        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {treatments.map((t) => (
            <article class="group flex flex-col rounded-3xl border border-teal-900/10 bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-teal-300 hover:shadow-xl hover:shadow-teal-900/5">
              <h3 class="font-[Fraunces,serif] text-2xl font-medium text-teal-950">{t.name}</h3>
              <p class="mt-3 flex-1 text-slate-600">{t.text}</p>
              <div class="mt-6 flex items-end justify-between border-t border-teal-900/10 pt-5">
                <p><span class="text-xs uppercase tracking-wider text-slate-500">desde</span><br /><span class="font-[Fraunces,serif] text-3xl font-semibold text-teal-700">US$ {t.from}</span></p>
                <a href={buildWhatsAppUrl(WHATSAPP_NUMBER, `Hola, me interesa ${t.name}. ¿Me comparten más información y disponibilidad?`)} class="text-sm font-semibold text-teal-700 hover:underline" aria-label={`Consultar ${t.name} por WhatsApp`}>Consultar →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="resultados" class="bg-teal-950 px-5 py-24 text-white">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
        <div data-reveal>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Resultados reales</p>
          <h2 class="mt-3 font-[Fraunces,serif] text-4xl font-medium sm:text-5xl">Mira la diferencia</h2>
          <p class="mt-5 max-w-md text-lg text-teal-100/80">Desliza la barra para comparar el antes y el después de un tratamiento de blanqueamiento y alineación.</p>
          <a href={bookingUrl} class="mt-8 inline-flex items-center justify-center rounded-full bg-white px-8 py-4 font-semibold text-teal-900 transition hover:bg-teal-50">Quiero mi cambio</a>
        </div>
        <div data-reveal>
          <div data-compare style="--pos:50%" class="relative aspect-[4/3] w-full select-none overflow-hidden rounded-3xl shadow-2xl shadow-black/30">
            <Image src={photo('1609840114035-3c981b782dfe')} alt="Después del tratamiento: sonrisa luminosa y alineada" width="1000" height="750" loading="lazy" draggable="false" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)">
              <Image src={photo('1609840114035-3c981b782dfe')} alt="Antes del tratamiento: dientes opacos y con manchas" width="1000" height="750" loading="lazy" draggable="false" class="h-full w-full object-cover [filter:sepia(0.85)_saturate(0.9)_brightness(0.82)_contrast(0.95)]" />
            </div>
            <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-black/55 px-3 py-1 text-xs font-semibold uppercase tracking-wider">Antes</span>
            <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-teal-900">Después</span>
            <input data-compare-input type="range" min="0" max="100" step="1" value="50" aria-label="Comparar antes y después" class="peer absolute inset-0 z-10 h-full w-full cursor-ew-resize opacity-0 [touch-action:pan-y]" />
            <div class="pointer-events-none peer-focus-visible:[&>span]:ring-4 absolute inset-y-0 z-[5] w-0.5 -translate-x-1/2 bg-white shadow-[0_0_12px_rgba(0,0,0,0.4)]" style="left: var(--pos)">
              <span class="absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-teal-800 shadow-xl ring-teal-300" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6" /></svg>
              </span>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-teal-200/60">Imagen ilustrativa. Los resultados pueden variar según cada paciente.</p>
        </div>
      </div>
    </section>

    <section id="equipo" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-600">Nuestro equipo</p>
          <h2 class="mt-3 font-[Fraunces,serif] text-4xl font-medium text-teal-950 sm:text-5xl">Especialistas que te escuchan</h2>
        </div>
        <div class="mt-14 grid gap-8 sm:grid-cols-3" data-reveal-group>
          {team.map((m) => (
            <figure>
              <div class="aspect-[5/6] overflow-hidden rounded-3xl bg-teal-50">
                <Image src={photo(m.img)} alt={m.alt} width="600" height="720" loading="lazy" class="h-full w-full object-cover transition duration-700 hover:scale-105" />
              </div>
              <figcaption class="mt-4">
                <p class="font-[Fraunces,serif] text-xl font-medium text-teal-950">{m.name}</p>
                <p class="text-sm text-slate-500">{m.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-teal-50 px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <h2 data-reveal class="text-center font-[Fraunces,serif] text-4xl font-medium text-teal-950 sm:text-5xl">Lo que dicen nuestros pacientes</h2>
        <div class="mt-14 grid gap-6 md:grid-cols-3" data-reveal-group>
          {testimonials.map((t) => (
            <blockquote class="flex flex-col rounded-3xl bg-white p-8 shadow-sm">
              <p class="text-amber-400" role="img" aria-label="5 de 5 estrellas">★★★★★</p>
              <p class="mt-4 flex-1 text-lg leading-relaxed text-slate-700">“{t.text}”</p>
              <footer class="mt-6 flex items-center gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-teal-600 font-semibold text-white" aria-hidden="true">{t.name[0]}</span>
                <span><span class="block font-semibold text-teal-950">{t.name}</span><span class="text-sm text-slate-500">{t.treatment}</span></span>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="px-5 py-24">
      <div class="mx-auto max-w-3xl">
        <h2 data-reveal class="text-center font-[Fraunces,serif] text-4xl font-medium text-teal-950 sm:text-5xl">Preguntas frecuentes</h2>
        <div class="mt-12 divide-y divide-teal-900/10 border-y border-teal-900/10" data-reveal>
          {faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-teal-950 [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-teal-50 text-teal-700 transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-2xl leading-relaxed text-slate-600">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="ubicacion" class="px-5 pb-28 md:pb-24">
      <div data-reveal class="mx-auto grid max-w-6xl overflow-hidden rounded-[2rem] bg-teal-900 text-white lg:grid-cols-2">
        <div class="p-8 sm:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Ubicación</p>
          <h2 class="mt-3 font-[Fraunces,serif] text-4xl font-medium">Visítanos</h2>
          <address class="mt-6 space-y-1 not-italic text-teal-50/90">
            <p>Av. Providencia 1234, Oficina 502</p>
            <p>Santiago, Chile</p>
          </address>
          <dl class="mt-8 space-y-2 text-teal-50/90">
            <div class="flex justify-between gap-6 border-b border-white/10 pb-2"><dt>Lunes a viernes</dt><dd>9:00 – 19:00</dd></div>
            <div class="flex justify-between gap-6 border-b border-white/10 pb-2"><dt>Sábados</dt><dd>9:00 – 14:00</dd></div>
            <div class="flex justify-between gap-6"><dt>Domingos</dt><dd>Urgencias</dd></div>
          </dl>
          <a href={bookingUrl} class="mt-10 inline-flex items-center justify-center rounded-full bg-white px-8 py-4 font-semibold text-teal-900 transition hover:bg-teal-50">Agendar por WhatsApp</a>
        </div>
        <div class="relative min-h-[260px] bg-teal-800 [background-image:linear-gradient(rgba(255,255,255,.07)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.07)_1px,transparent_1px)] [background-size:40px_40px]" role="img" aria-label="Mapa ilustrativo de la ubicación de la clínica">
          <span class="absolute left-1/2 top-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-2xl shadow-xl" aria-hidden="true">📍</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-teal-900/10 px-5 pb-24 pt-8 text-center text-sm text-slate-500 md:pb-8">
    © {new Date().getFullYear()} {BRAND}. Demo ficticia · <a href="/" class="underline hover:text-teal-700">Ver portafolio</a>
  </footer>

  <a href={bookingUrl} class="fixed inset-x-4 bottom-4 z-40 flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-4 font-semibold text-white shadow-xl shadow-black/20 md:hidden">
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.1c-.2.6-1.3 1.1-1.8 1.2-.5.1-1.1.1-1.8-.1a14 14 0 0 1-4.9-3 8.2 8.2 0 0 1-1.7-2.4c-.2-.7-.1-1.4.3-1.9.2-.2.4-.4.6-.4h.4c.2 0 .3 0 .5.4l.7 1.7c.1.200.1.300 0 .5l-.3.400-.3.300c-.1.1-.2.300-.1.5.4.700 1 1.300 1.6 1.800a6 6 0 0 0 1.800 1c.2.1.4.1.5-.1l.7-.8c.2-.2.300-.2.5-.1l1.6.8c.2.1.4.200.4.300.1.200.1.6-.1 1.200Z" /></svg>
    Reservar por WhatsApp
  </a>

  <script>
    import { initCompareSliders } from '../scripts/compare-slider';
    initCompareSliders();
  </script>
</Base>
