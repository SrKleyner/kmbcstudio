---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { DEMOS, DEVELOPER, WHATSAPP_NUMBER } from '../config';
import { preview } from '../lib/photos';
import { readableTextOn } from '../lib/slider';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const contactUrl = buildWhatsAppUrl(
  WHATSAPP_NUMBER,
  'Hola, vi tu portafolio y quiero una página web para mi negocio.',
);

/** "#rrggbb" -> "r, g, b" so CSS can use rgb(var(--bg) / alpha) and GSAP can tween the numbers. */
const channels = (hex: string) => {
  const h = hex.replace('#', '');
  return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)).join(', ');
};

const palettes = DEMOS.map((d) => ({ bg: channels(d.bg), fg: channels(readableTextOn(d.bg)) }));
const [firstName, lastName] = DEVELOPER.name.toUpperCase().split(' ');

// 3 demos only: repeat the set so the looping track always fills the screen.
const COPIES = 3;
const slides = Array.from({ length: DEMOS.length * COPIES }, (_, i) => ({ demo: DEMOS[i % DEMOS.length], index: i % DEMOS.length, clone: i >= DEMOS.length }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={`${DEVELOPER.name} | ${DEVELOPER.tagline}`}
  description="Diseño y desarrollo de landing pages y automatización por WhatsApp para negocios. Mira demos reales y pide la tuya."
  bodyClass="h-dvh overflow-hidden bg-[rgb(var(--bg))] text-[rgb(var(--fg))] font-sans antialiased"
  bodyStyle={`--bg:${palettes[0].bg};--fg:${palettes[0].fg}`}
  themeColor={DEMOS[0].bg}
>
  <main data-home data-count={DEMOS.length} class="home relative h-dvh w-screen overflow-hidden">
    <!-- Decorative outlined marquee: moves opposite to the slider -->
    <div class="home-marquee pointer-events-none absolute inset-x-0 top-[46%] -translate-y-1/2 select-none" aria-hidden="true">
      <div data-marquee class="flex w-max whitespace-nowrap">
        {[0, 1].map(() => (
          <span class="font-display pr-[4vw] text-[clamp(7rem,22vh,16rem)] font-bold uppercase leading-none">
            Landings que convierten · Visitas en clientes ·&nbsp;
          </span>
        ))}
      </div>
    </div>

    <header class="pointer-events-none absolute inset-x-0 top-0 z-40 flex items-start justify-between gap-4 p-[clamp(16px,3vw,48px)]">
      <p data-fade class="pointer-events-auto max-w-[16rem] text-[11px] font-medium uppercase leading-snug tracking-[0.18em] sm:max-w-none sm:text-xs">
        {DEVELOPER.role}<br class="sm:hidden" /><span class="hidden sm:inline"> — </span>{DEVELOPER.tagline}
      </p>
      <a
        data-fade
        href={contactUrl}
        class="pointer-events-auto inline-flex shrink-0 items-center gap-2 rounded-full bg-[rgb(var(--fg))] px-5 py-3 text-sm font-semibold text-[rgb(var(--bg))] transition-[scale,background-color,color] hover:scale-105"
      >
        Escríbeme <span aria-hidden="true">↗</span>
      </a>
    </header>

    <h1 class="home-word font-display pointer-events-none absolute inset-x-0 top-[12vh] z-10 flex flex-col px-[clamp(16px,3vw,48px)] font-bold uppercase leading-[0.82] tracking-[-0.045em] md:flex-row md:items-start md:justify-between" aria-label={DEVELOPER.name}>
      <span class="block overflow-hidden pb-[0.06em]" aria-hidden="true"><span data-word="left" class="block will-change-transform">{firstName}</span></span>
      <span class="block self-end overflow-hidden pb-[0.06em] md:self-auto" aria-hidden="true"><span data-word="right" class="block will-change-transform">{lastName}</span></span>
    </h1>

    <!-- Infinite slider -->
    <section class="home-stage absolute inset-x-0 bottom-0 top-0 z-20 touch-none" aria-roledescription="carousel" aria-label="Demos de landing pages" data-stage>
      <div class="home-track" data-track>
        {slides.map((s, i) => (
          <a
            href={`/${s.demo.slug}`}
            data-slide
            data-index={s.index}
            draggable="false"
            class="home-slide group"
            aria-hidden={s.clone ? 'true' : undefined}
            tabindex={s.clone ? -1 : undefined}
            aria-label={`${s.demo.name}: ${s.demo.niche}. Abrir demo`}
          >
            <span data-float class="block">
              <span data-card class="home-card block overflow-hidden rounded-[clamp(10px,1.4vw,22px)] shadow-[0_30px_80px_-20px_rgb(0_0_0/0.55)] ring-1 ring-black/10">
                <Image
                  data-shot
                  src={preview(s.demo.slug)}
                  alt={`Vista previa de la landing ${s.demo.name}`}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 768px) 46vw, 78vw"
                  loading="eager"
                  decoding="async"
                  draggable="false"
                  class="block aspect-[8/5] w-full select-none object-cover object-top"
                />
              </span>
              <span class="mt-3 flex items-baseline justify-between gap-4 text-sm">
                <span class="font-display text-base font-semibold sm:text-lg">{s.demo.name}</span>
                <span class="text-xs uppercase tracking-[0.16em] opacity-70">{s.demo.niche}</span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Controls -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-40 flex items-end justify-between gap-4 p-[clamp(16px,3vw,48px)]">
      <div data-fade class="pointer-events-auto flex items-center gap-4">
        <button type="button" data-prev class="home-btn" aria-label="Demo anterior">←</button>
        <button type="button" data-next class="home-btn" aria-label="Demo siguiente">→</button>
        <p class="font-display text-lg font-semibold tabular-nums" aria-live="polite">
          <span data-current>{pad(1)}</span> <span class="opacity-50">/ {pad(DEMOS.length)}</span>
        </p>
      </div>
      <a
        data-fade
        href="/servicios"
        class="pointer-events-auto inline-flex items-center gap-3 rounded-full border border-current px-6 py-3.5 text-sm font-semibold transition-[background-color,color] hover:bg-[rgb(var(--fg))] hover:text-[rgb(var(--bg))]"
      >
        Servicios <span aria-hidden="true">→</span>
      </a>
    </div>

    <noscript>
      <style>
        .home-slide { visibility: visible !important; position: static !important; width: 80vw !important; margin: 16px auto !important; }
        .home-track { position: static !important; display: block; height: auto !important; }
        main[data-home] { height: auto !important; overflow: auto !important; }
      </style>
    </noscript>
  </main>

  <script type="application/json" id="home-palettes" set:html={JSON.stringify(palettes)} />
  <script>
    import { initHome } from '../scripts/home';
    initHome();
  </script>
</Base>
