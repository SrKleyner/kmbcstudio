---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photo, ogImage } from '../lib/photos';
import { WHATSAPP_NUMBER } from '../config';
import { PLANS } from '../lib/quiz';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const BRAND = 'Forja Training';
const contactUrl = buildWhatsAppUrl(WHATSAPP_NUMBER, `Hola ${BRAND}, quiero información sobre los planes de entrenamiento.`);

const questions = [
  { name: 'goal', title: '¿Cuál es tu objetivo principal?', options: [['fat-loss', 'Perder grasa'], ['muscle', 'Ganar músculo'], ['performance', 'Mejorar rendimiento'], ['health', 'Salud y bienestar']] },
  { name: 'level', title: '¿Cuál es tu nivel actual?', options: [['beginner', 'Principiante'], ['intermediate', 'Intermedio'], ['advanced', 'Avanzado']] },
  { name: 'days', title: '¿Cuántos días por semana puedes entrenar?', options: [['2', '2 días'], ['3', '3 días'], ['4', '4 días'], ['5', '5 o más']] },
  { name: 'mode', title: '¿Cómo prefieres entrenar?', options: [['online', 'Online, a mi ritmo'], ['in-person', 'Presencial con mi coach']] },
];

const stats = [['+1.200', 'Atletas entrenados'], ['12 sem.', 'Para ver resultados'], ['4.9/5', 'Satisfacción']];

const transformations = [
  { name: 'Diego, 29', result: '-14 kg', time: '16 semanas', text: 'Pasé de no poder subir las escaleras sin cansarme a correr mi primera media maratón.', photo: '1517836357463-d25dfeac3438', alt: 'Atleta levantando una barra con discos' },
  { name: 'Mariana, 34', result: '+5 kg músculo', time: '20 semanas', text: 'Por fin entendí cómo comer y entrenar. La rutina se adapta a mis horarios de trabajo.', photo: '1571019613454-1cb2f99b2d8b', alt: 'Mujer haciendo abdominales sobre una colchoneta' },
  { name: 'Andrés, 41', result: '-9 kg', time: '12 semanas', text: 'Entrenar con seguimiento semanal me mantuvo constante. Hoy tengo más energía que a los 25.', photo: '1549060279-7e168fcee0c2', alt: 'Atleta ajustando su agarre antes de levantar' },
];

const testimonials = [
  { name: 'Sofía L.', text: 'El quiz me recomendó el plan perfecto. En dos semanas ya sentía la diferencia.' },
  { name: 'Javier R.', text: 'Mi coach responde rápido y ajusta todo según cómo me siento. Súper profesional.' },
  { name: 'Valeria C.', text: 'Entreno online desde casa y nunca me sentí sola. La comunidad motiva muchísimo.' },
];
---

<Base
  title={`${BRAND} | Entrena con un plan hecho para ti`}
  description="Planes de entrenamiento personalizados online y presencial. Responde 4 preguntas y descubre tu plan ideal."
  fontsHref="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
  bodyClass="bg-ink text-zinc-100 font-sans antialiased selection:bg-volt selection:text-white"
  themeColor="#08080b"
  image={ogImage('1534438327276-14e5300c3a48', Astro.site)}
>
  <header class="absolute inset-x-0 top-0 z-20">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-6" aria-label="Principal">
      <a href="/training" class="font-[Barlow_Condensed,sans-serif] text-3xl font-extrabold uppercase tracking-wide">Forja<span class="text-volt">.</span></a>
      <div class="flex items-center gap-6 text-sm font-semibold uppercase tracking-wider">
        <a href="#planes" class="hidden hover:text-volt sm:inline">Planes</a>
        <a href="#resultados" class="hidden hover:text-volt sm:inline">Resultados</a>
        <a href="#quiz" class="rounded-full bg-volt px-5 py-2.5 text-white transition hover:bg-volt-light">Empezar</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="relative isolate flex min-h-[92svh] items-end overflow-hidden px-5 pb-20 pt-40">
      <Image loading="eager" fetchpriority="high" data-parallax="40" src={photo('1534438327276-14e5300c3a48')} alt="Gimnasio con mancuernas ordenadas y una persona entrenando al fondo" width="1600" height="1100" class="absolute inset-0 -z-20 h-[120%] w-full object-cover opacity-50 grayscale" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/30" aria-hidden="true"></div>
      <div class="absolute -right-40 top-20 -z-10 h-[500px] w-[500px] rounded-full bg-volt/30 blur-[140px]" aria-hidden="true"></div>
      <div class="mx-auto w-full max-w-6xl" data-hero>
        <p class="inline-block border-l-4 border-volt pl-3 text-sm font-bold uppercase tracking-[0.25em] text-volt-light">Entrenamiento personalizado</p>
        <h1 class="mt-6 font-[Barlow_Condensed,sans-serif] text-[4rem] font-extrabold uppercase leading-[0.9] sm:text-[8rem] lg:text-[10rem]">
          Forja tu <span class="text-volt">mejor versión</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-zinc-300 sm:text-xl">Planes diseñados para tu nivel, tu tiempo y tu objetivo. Responde 4 preguntas y recibe tu plan ideal en menos de un minuto.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="#quiz" class="inline-flex items-center justify-center bg-volt px-9 py-4 text-lg font-bold uppercase tracking-wider text-white transition hover:bg-volt-light [clip-path:polygon(0_0,100%_0,calc(100%-14px)_100%,0_100%)]">Descubrir mi plan</a>
          <a href="#planes" class="inline-flex items-center justify-center border border-white/30 px-9 py-4 text-lg font-bold uppercase tracking-wider transition hover:border-volt hover:text-volt">Ver planes</a>
        </div>
        <dl class="mt-14 grid max-w-xl grid-cols-3 gap-4 border-t border-white/15 pt-6">
          {stats.map(([n, l]) => (
            <div><dt class="sr-only">{l}</dt><dd class="font-[Barlow_Condensed,sans-serif] text-3xl font-bold text-white sm:text-4xl">{n}</dd><p class="text-xs uppercase tracking-wider text-zinc-400">{l}</p></div>
          ))}
        </dl>
      </div>
    </section>

    <section id="planes" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.25em] text-volt">Planes</p>
          <h2 class="mt-3 font-[Barlow_Condensed,sans-serif] text-5xl font-extrabold uppercase leading-none sm:text-7xl">Elige tu nivel de compromiso</h2>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-3" data-reveal-group>
          {PLANS.map((p) => (
            <article class={`relative flex flex-col p-8 ${p.id === 'progreso' ? 'border-2 border-volt bg-volt/10' : 'border border-white/10 bg-ink-soft'}`}>
              {p.id === 'progreso' && <span class="absolute -top-3 left-8 bg-volt px-3 py-1 text-xs font-bold uppercase tracking-wider">Más elegido</span>}
              <h3 class="font-[Barlow_Condensed,sans-serif] text-3xl font-bold uppercase">{p.name}</h3>
              <p class="mt-2 text-zinc-400">{p.tagline}</p>
              <p class="mt-6 font-[Barlow_Condensed,sans-serif] text-6xl font-extrabold">US$ {p.price}<span class="text-lg font-medium text-zinc-500"> /mes</span></p>
              <ul class="mt-6 flex-1 space-y-3 text-zinc-300">
                {p.features.map((f) => <li class="flex gap-2"><span class="text-volt" aria-hidden="true">✓</span>{f}</li>)}
              </ul>
              <a href="#quiz" class="mt-8 inline-flex items-center justify-center border border-white/30 px-6 py-3.5 font-bold uppercase tracking-wider transition hover:border-volt hover:bg-volt">Elegir {p.name.replace('Forja ', '')}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="quiz" class="scroll-mt-4 bg-ink-soft px-5 py-24">
      <div class="mx-auto max-w-3xl">
        <div data-reveal class="text-center">
          <p class="text-sm font-bold uppercase tracking-[0.25em] text-volt">Quiz de 1 minuto</p>
          <h2 class="mt-3 font-[Barlow_Condensed,sans-serif] text-5xl font-extrabold uppercase leading-none sm:text-7xl">¿Cuál es tu plan ideal?</h2>
        </div>

        <div data-quiz class="mt-12 border border-white/10 bg-ink p-6 sm:p-10" data-reveal>
          <div class="flex items-center justify-between text-sm">
            <p data-step-label class="font-semibold uppercase tracking-wider text-zinc-400" aria-live="polite">Pregunta 1 de 4</p>
            <button type="button" data-back hidden class="font-semibold text-volt-light underline underline-offset-4">← Volver</button>
          </div>
          <div class="mt-3 h-1.5 overflow-hidden bg-white/10" role="presentation"><div data-progress class="h-full w-1/5 bg-volt transition-all duration-500"></div></div>

          <div class="mt-8">
            {questions.map((q, i) => (
              <fieldset data-step hidden={i !== 0}>
                <legend class="font-[Barlow_Condensed,sans-serif] text-3xl font-bold uppercase sm:text-4xl">{q.title}</legend>
                <div class="mt-6 grid gap-3 sm:grid-cols-2">
                  {q.options.map(([value, label]) => (
                    <label class="flex min-h-14 cursor-pointer items-center gap-3 border border-white/15 px-5 py-4 text-lg font-semibold transition hover:border-volt has-[:checked]:border-volt has-[:checked]:bg-volt/15 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-volt">
                      <input type="radio" name={q.name} value={value} class="h-4 w-4 accent-[#ff4a1c]" />
                      {label}
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>

          <div data-result hidden>
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-volt">Tu plan recomendado · <span data-plan-mode></span></p>
            <h3 data-plan-name class="mt-2 font-[Barlow_Condensed,sans-serif] text-5xl font-extrabold uppercase sm:text-6xl"></h3>
            <p data-plan-price class="mt-1 font-[Barlow_Condensed,sans-serif] text-4xl font-bold text-volt"></p>
            <p data-plan-tagline class="mt-3 text-lg text-zinc-300"></p>
            <p data-plan-reason class="mt-2 text-zinc-400"></p>
            <ul data-plan-features class="mt-5 space-y-2 text-zinc-300"></ul>

            <form data-lead-form class="mt-8 space-y-4 border-t border-white/10 pt-6">
              <p class="font-semibold">Déjanos tus datos y tu coach te escribe hoy:</p>
              <label class="block text-sm font-semibold">Tu nombre
                <input name="name" required autocomplete="name" class="mt-1 w-full border border-white/20 bg-ink-soft px-4 py-3 text-base font-normal text-white placeholder:text-zinc-500" placeholder="Ej: Carlos Pérez" />
              </label>
              <label class="block text-sm font-semibold">Tu WhatsApp
                <input name="whatsapp" required type="tel" inputmode="tel" autocomplete="tel" minlength="7" class="mt-1 w-full border border-white/20 bg-ink-soft px-4 py-3 text-base font-normal text-white placeholder:text-zinc-500" placeholder="+58 412 0000000" />
              </label>
              <button data-submit type="submit" class="flex w-full items-center justify-center bg-volt px-6 py-4 text-lg font-bold uppercase tracking-wider text-white transition hover:bg-volt-light disabled:opacity-60">Quiero mi plan</button>
              <p data-form-error hidden role="alert" class="text-sm text-amber-300">No pudimos registrar tus datos, pero abrimos WhatsApp para que nos escribas directo.</p>
            </form>

            <div data-done hidden class="mt-8 border border-volt/50 bg-volt/10 p-6" role="status">
              <p class="font-[Barlow_Condensed,sans-serif] text-3xl font-bold uppercase">¡Listo, ya tenemos tus datos!</p>
              <p class="mt-2 text-zinc-300">Tu coach te contactará muy pronto. Si quieres adelantar, escríbenos ahora.</p>
              <a data-done-link href={contactUrl} target="_blank" rel="noopener" class="mt-5 inline-flex items-center justify-center bg-[#25D366] px-6 py-3.5 font-bold text-black">Escribir por WhatsApp</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="resultados" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.25em] text-volt">Transformaciones</p>
          <h2 class="mt-3 font-[Barlow_Condensed,sans-serif] text-5xl font-extrabold uppercase leading-none sm:text-7xl">Resultados que se notan</h2>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-3" data-reveal-group>
          {transformations.map((t) => (
            <article class="group overflow-hidden border border-white/10 bg-ink-soft">
              <div class="relative aspect-[4/5] overflow-hidden">
                <Image src={photo(t.photo)} alt={t.alt} width="700" height="875" loading="lazy" class="h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0" />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/70 to-transparent p-6 pt-20">
                  <p class="font-[Barlow_Condensed,sans-serif] text-5xl font-extrabold text-volt">{t.result}</p>
                  <p class="text-sm uppercase tracking-wider text-zinc-300">en {t.time}</p>
                </div>
              </div>
              <div class="p-6"><p class="font-bold uppercase tracking-wide">{t.name}</p><p class="mt-2 text-zinc-400">“{t.text}”</p></div>
            </article>
          ))}
        </div>
        <p class="mt-4 text-xs text-zinc-500">Testimonios ilustrativos de una marca ficticia. Los resultados dependen de cada persona.</p>

        <div class="mt-16 grid gap-5 md:grid-cols-3" data-reveal-group>
          {testimonials.map((t) => (
            <blockquote class="border-l-4 border-volt bg-ink-soft p-6">
              <p class="text-volt" role="img" aria-label="5 de 5 estrellas">★★★★★</p>
              <p class="mt-3 text-lg text-zinc-200">“{t.text}”</p>
              <footer class="mt-4 text-sm font-bold uppercase tracking-wider text-zinc-400">{t.name}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 pb-24">
      <div data-reveal class="mx-auto max-w-6xl bg-volt px-8 py-14 text-center sm:py-20">
        <h2 class="font-[Barlow_Condensed,sans-serif] text-5xl font-extrabold uppercase leading-none sm:text-7xl">Empieza hoy. Sin excusas.</h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-white/90">La primera semana es de prueba: si no es para ti, no pagas.</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="#quiz" class="inline-flex items-center justify-center bg-ink px-9 py-4 text-lg font-bold uppercase tracking-wider text-white transition hover:bg-black">Hacer el quiz</a>
          <a href={contactUrl} class="inline-flex items-center justify-center border-2 border-white px-9 py-4 text-lg font-bold uppercase tracking-wider text-white transition hover:bg-white hover:text-ink">Hablar por WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 px-5 py-8 text-center text-sm text-zinc-500">
    © {new Date().getFullYear()} {BRAND}. Demo ficticia · <a href="/" class="underline hover:text-white">Ver portafolio</a>
  </footer>

  <script>
    import { initTrainingQuiz } from '../scripts/training-quiz';
    initTrainingQuiz();
  </script>
</Base>
