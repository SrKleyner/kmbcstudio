---
import Base from '../layouts/Base.astro';
import { DEVELOPER, SERVICES, WHATSAPP_NUMBER } from '../config';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const contactUrl = buildWhatsAppUrl(
  WHATSAPP_NUMBER,
  'Hola, vi tu portafolio y quiero cotizar una página web para mi negocio.',
);

const steps = [
  { n: '01', title: 'Conversamos', text: 'Me cuentas de tu negocio por WhatsApp y definimos objetivo, estilo y contenido.' },
  { n: '02', title: 'Te muestro un borrador', text: 'En pocos días recibes una propuesta visual real para aprobar o ajustar.' },
  { n: '03', title: 'Publicamos', text: 'Tu página sale online con dominio propio, rápida y lista para recibir clientes.' },
  { n: '04', title: 'Te acompaño', text: 'Soporte y mejoras continuas para que tu web siga trayendo resultados.' },
];

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<Base
  title={`Servicios y precios | ${DEVELOPER.name}`}
  description="Landing pages, automatización por WhatsApp y mantenimiento con precios claros. Conoce el proceso y pide tu propuesta."
  bodyClass="bg-[#0b0b10] text-white font-sans antialiased selection:bg-lime-300 selection:text-black"
  themeColor="#0b0b10"
>
  <header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between p-(--gutter) mix-blend-difference">
    <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-white">
      <span aria-hidden="true">←</span> Portafolio
    </a>
    <a href={contactUrl} class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-black transition-[scale] hover:scale-105">
      Escríbeme <span aria-hidden="true">↗</span>
    </a>
  </header>

  <main>
    <!-- 1. Servicios y precios -->
    <section id="servicios" class="relative overflow-hidden pb-(--section-y) pt-[clamp(96px,13vh,160px)]" aria-labelledby="servicios-title">
      <p class="t-label px-(--gutter) text-lime-300">01 — Servicios</p>
      <h2 id="servicios-title" class="t-display font-display mt-4 px-(--gutter) font-bold uppercase" aria-label="Servicios y precios">
        <span class="block" data-sweep="-1" aria-hidden="true">Servicios</span>
        <span class="block" data-sweep="1" aria-hidden="true">y precios</span>
      </h2>

      <ol class="mt-(--section-y) border-t border-white/15">
        {SERVICES.map((s, i) => (
          <li class="svc group relative overflow-hidden border-b border-white/15" data-row>
            <span class="t-ghost font-display pointer-events-none absolute right-(--gutter) top-1/2 -translate-y-1/2 select-none" data-drift="40" aria-hidden="true">{pad(i)}</span>
            <div class="relative grid items-baseline gap-x-[3vw] gap-y-4 px-(--gutter) py-[clamp(28px,4.5vw,72px)] md:grid-cols-[minmax(0,1fr)_auto]" data-row-inner={i % 2 === 0 ? '-1' : '1'}>
              <p class="t-label text-white/50 md:col-span-2">{pad(i)}</p>
              <h3 class="t-row font-display font-bold uppercase transition-colors duration-300 group-hover:text-lime-300">{s.title}</h3>
              <p class="flex items-baseline gap-3 md:justify-end">
                <span class="t-label text-white/50">desde</span>
                <span class="t-row font-display whitespace-nowrap font-bold">US$ {s.from}<span class="text-[0.3em] font-medium tracking-normal text-white/50">{s.title === 'Mantenimiento' ? ' /mes' : ''}</span></span>
              </p>
              <p class="max-w-xl text-base leading-relaxed text-white/70 md:col-span-2 md:text-lg">{s.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="px-(--gutter) pt-6 text-sm text-white/50">Precios en dólares. Cada propuesta se ajusta a tu negocio, sin compromiso.</p>
    </section>

    <!-- Ticker -->
    <div class="overflow-hidden border-y border-white/15 bg-lime-300 py-4 text-black" aria-hidden="true">
      <div class="flex w-max whitespace-nowrap" data-ticker>
        {[0, 1].map(() => (
          <span class="font-display pr-8 text-2xl font-bold uppercase tracking-[-0.02em] sm:text-4xl">
            Landings · WhatsApp · Reservas · Pedidos · Mantenimiento · Resultados ·&nbsp;
          </span>
        ))}
      </div>
    </div>

    <!-- 2. Proceso (pinned horizontal scroll) -->
    <section id="proceso" class="process relative overflow-hidden" aria-labelledby="proceso-title" data-process>
      <div class="process-pin flex min-h-dvh flex-col justify-center gap-[clamp(16px,3.5vh,48px)] pb-[clamp(24px,5vh,56px)] pt-[clamp(80px,13vh,128px)]" data-process-pin>
        <div class="flex items-end justify-between gap-6 px-(--gutter)">
          <div>
            <p class="t-label text-lime-300">02 — Proceso</p>
            <h2 id="proceso-title" class="t-h2 font-display mt-3 font-bold uppercase">Simple, rápido<br />y sin sorpresas</h2>
          </div>
          <p class="t-label hidden pb-3 text-white/50 md:block" aria-hidden="true">Desliza →</p>
        </div>

        <div class="process-track flex gap-[clamp(12px,2vw,32px)] px-(--gutter)" data-process-track>
          {steps.map((step) => (
            <article class="process-card relative flex shrink-0 flex-col justify-between overflow-hidden rounded-[clamp(16px,2vw,32px)] border border-white/15 bg-white/[0.04] p-[clamp(20px,2.4vw,40px)]">
              <span class="t-step font-display font-bold text-lime-300" data-step-num>{step.n}</span>
              <div>
                <h3 class="t-card font-display font-bold uppercase">{step.title}</h3>
                <p class="mt-3 max-w-md text-base leading-relaxed text-white/70">{step.text}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="mx-(--gutter) h-px bg-white/15" aria-hidden="true">
          <div class="h-full origin-left scale-x-0 bg-lime-300" data-progress></div>
        </div>
      </div>
    </section>

    <!-- 3. Hablemos de tu negocio -->
    <section id="contacto" class="relative overflow-hidden bg-lime-300 text-black" aria-labelledby="contacto-title">
      <div class="relative flex min-h-dvh flex-col justify-between gap-[clamp(24px,5vh,48px)] px-(--gutter) pb-6 pt-[clamp(96px,13vh,160px)]">
        <div>
          <p class="t-label">03 — Contacto</p>
          <h2 id="contacto-title" class="t-contact font-display mt-4 font-bold uppercase">
            <span class="block" data-reveal-x="-1">Hablemos</span>
            <span class="block" data-reveal-x="1">de tu negocio</span>
          </h2>
        </div>

        <div class="grid items-end gap-10 md:grid-cols-[minmax(0,1fr)_auto]">
          <div class="max-w-xl">
            <p class="text-lg leading-relaxed md:text-xl">Cuéntame qué vendes y te preparo una propuesta sin compromiso. Aceptamos <strong>USDT</strong> y <strong>Binance Pay</strong>: 50% al iniciar y 50% al entregar.</p>
            <a href="/" class="mt-6 inline-flex items-center gap-2 border-b-2 border-black pb-1 text-sm font-semibold uppercase tracking-[0.16em] transition-[gap] hover:gap-4">
              <span aria-hidden="true">←</span> Volver al portafolio
            </a>
          </div>
          <a href={contactUrl} data-magnet class="t-cta font-display inline-flex items-center justify-center gap-3 rounded-full bg-black px-[clamp(28px,4vw,64px)] py-[clamp(20px,2.6vw,40px)] font-bold uppercase tracking-[-0.02em] text-lime-300 transition-[background-color,color] hover:bg-white hover:text-black">
            Escribir por WhatsApp <span aria-hidden="true">↗</span>
          </a>
        </div>

        <footer class="flex flex-wrap items-center justify-between gap-2 border-t border-black/20 pt-5 text-sm">
          <span>© {new Date().getFullYear()} {DEVELOPER.name} · kmbcstudio.com</span>
          <span>Las marcas de las demos son ficticias.</span>
        </footer>
      </div>
    </section>
  </main>

  <script>
    import { initServicios } from '../scripts/servicios';
    initServicios();
  </script>
</Base>
