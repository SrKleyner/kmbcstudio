---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Google Fonts stylesheet URL for the page's typefaces. */
  fontsHref?: string;
  /** Absolute URL of the social preview image. */
  image?: string;
  /** Classes applied to <body> (theme colors, base font). */
  bodyClass?: string;
  themeColor?: string;
  /** Inline style for <body> (e.g. CSS variables). */
  bodyStyle?: string;
  /** Shows the small "← Portafolio" control (used by the demo landings). */
  backLink?: boolean;
}

const {
  title,
  description,
  fontsHref = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap',
  image,
  bodyClass = 'bg-white text-slate-900 font-sans antialiased',
  themeColor = '#ffffff',
  bodyStyle,
  backLink = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_LA" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body class={bodyClass} style={bodyStyle}>
    <script is:inline>
      /* Continues the home -> demo expanding transition: fade out the overlay that mirrors the clicked preview. */
      (function () {
        try {
          var raw = sessionStorage.getItem('kmbc-intro');
          if (!raw) return;
          sessionStorage.removeItem('kmbc-intro');
          var data = JSON.parse(raw);
          if (!data.src || Date.now() - data.ts > 8000) return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var o = document.createElement('div');
          o.setAttribute('aria-hidden', 'true');
          o.style.cssText = 'position:fixed;inset:0;z-index:9999;pointer-events:none;background:#000 center/cover no-repeat url("' + data.src + '");transition:opacity .7s ease .15s';
          document.body.appendChild(o);
          var done = function () {
            o.style.opacity = '0';
            setTimeout(function () { o.remove(); }, 1000);
          };
          if (document.readyState === 'complete') requestAnimationFrame(done);
          else addEventListener('load', function () { requestAnimationFrame(done); });
          setTimeout(done, 3000);
        } catch (e) {}
      })();
    </script>
    <slot />
    {backLink && (
      <a
        href="/"
        class="fixed bottom-24 left-4 z-50 inline-flex items-center gap-2 rounded-full bg-black/70 px-4 py-2 text-sm font-medium text-white shadow-lg shadow-black/20 ring-1 ring-white/20 backdrop-blur transition hover:bg-black md:bottom-5"
      >
        <span aria-hidden="true">←</span> Portafolio
      </a>
    )}
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
